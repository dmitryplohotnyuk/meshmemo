[Unit]
Description=MeshMemo - Meshtastic History Server
After=local-fs.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=meshmemo
Group=meshmemo
SupplementaryGroups=dialout
WorkingDirectory=/var/lib/meshmemo
ExecStart=/opt/meshmemo/venv/bin/meshtastic-sf-server serve --config /etc/meshmemo/config.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
StateDirectory=meshmemo
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meshmemo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
